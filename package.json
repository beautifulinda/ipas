{
  "name": "ipas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "nuxt generate && rm -rf .output/preview && mkdir -p .output/preview && cp -R .output/public .output/preview/ipas && npx serve -l 4173 --no-clipboard .output/preview",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "e2e:build": "IPAS_E2E=1 nuxt generate && rm -rf .output-e2e/site && mkdir -p .output-e2e/site && cp -R .output-e2e/public .output-e2e/site/ipas",
    "e2e": "bddgen && playwright test",
    "validate": "node scripts/validate-data.mjs",
    "review": "node scripts/review.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-polygon": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-voronoi-treemap": "^1.1.2",
    "d3-zoom": "^3.0.0",
    "idb": "^8.0.4",
    "nuxt": "^3.21.11",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-polygon": "^3.0.2",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "playwright-bdd": "^9.2.1",
    "quickpickle": "^1.11.2",
    "serve": "^14.2.6",
    "typescript": "~5.9",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
